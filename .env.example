# ===== Dùng chung cho local dev (docker-compose) =====

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platform369?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# ⚠️ SẢN XUẤT: PHẢI thay bằng chuỗi ngẫu nhiên mạnh (vd: openssl rand -base64 48),
# KHÔNG giữ nguyên giá trị "change-me-..." — đây chỉ để tiện local dev.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Tài khoản seed (prisma/seed.ts) ---
# Ở production, seed.ts sẽ THROW nếu thiếu 2 biến mật khẩu này — không cho phép
# tạo tài khoản admin/seller với mật khẩu mặc định đã công khai trong README.
SEED_ADMIN_EMAIL="admin@369.vn"
SEED_ADMIN_PASSWORD="change-me-admin-password"
SEED_SELLER_EMAIL="seller@369.vn"
SEED_SELLER_PASSWORD="change-me-seller-password"

# --- App ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ===== Phase 2: Bán hàng =====

# --- Payment (Mock Gateway — thay bằng VNPay/Momo thật khi triển khai) ---
# ⚠️ SẢN XUẤT: thay bằng chuỗi ngẫu nhiên mạnh riêng biệt, KHÔNG dùng chung với JWT_*.
PAYMENT_MOCK_SECRET="change-me-mock-payment-secret"
PAYMENT_RETURN_URL="http://localhost:3000/orders"

# --- Order timeout (Mục 4.1 spec: 15 phút chưa thanh toán -> tự huỷ) ---
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# --- Inventory reservation TTL (Redis lock) ---
INVENTORY_LOCK_TTL_MS=5000

# ===== Phase 4: Kế toán =====
PLATFORM_FEE_RATE=0.02

# Python Accounting Service (Mục 3.6 spec) — gọi nội bộ, KHÔNG public
ACCOUNTING_SERVICE_URL="http://localhost:8000"
# ⚠️ SẢN XUẤT: phải khớp với INTERNAL_API_KEY trong apps/accounting-service/.env,
# thay bằng chuỗi ngẫu nhiên mạnh — đây là key xác thực nội bộ giữa 2 service.
INTERNAL_API_KEY="change-me-internal-api-key"

# ===== Phase 5: Hệ sinh thái 369 =====
# Cứ mỗi POINTS_PER_VND đồng chi tiêu = 1 điểm tích luỹ (Mục 4.1 spec)
POINTS_PER_VND=10000

# ===== P4: Notification (Push qua Firebase Cloud Messaging) =====
# CHƯA BẮT BUỘC — nếu để trống, hệ thống vẫn chạy bình thường, chỉ GHI LOG
# vào notification_logs mà KHÔNG thực sự gửi push (NoopPushProvider).
# Cách lấy: console.firebase.google.com -> tạo project -> bật Cloud Messaging
# -> Project Settings -> Service Accounts -> Generate new private key (JSON).
# Điền TOÀN BỘ nội dung file JSON vào 1 dòng duy nhất (hoặc base64-encode nếu
# nền tảng hosting không hỗ trợ biến môi trường nhiều dòng), HOẶC dùng
# FIREBASE_SERVICE_ACCOUNT_PATH trỏ tới file JSON trên server thay vì dán trực tiếp.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_SERVICE_ACCOUNT_PATH="/path/to/firebase-service-account.json"

# ===== Bảo mật: mã hoá dữ liệu nhạy cảm tại rest (CCCD...) =====
# BẮT BUỘC ở production (app sẽ throw khi khởi động nếu thiếu). Sinh 1 lần bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TUYỆT ĐỐI không đổi giá trị này sau khi đã có dữ liệu mã hoá — sẽ không giải mã lại được.
FIELD_ENCRYPTION_KEY=""

# ===== Bảo mật: 2FA (TOTP) cho Admin/Super Admin =====
# Secret ký JWT tạm thời dùng cho bước xác thực 2FA giữa lúc nhập đúng mật khẩu
# và lúc nhập đúng mã OTP — KHÁC với JWT_ACCESS_SECRET (token đầy đủ quyền).
# Nếu để trống, hệ thống tự dùng JWT_ACCESS_SECRET (vẫn an toàn, nhưng khuyến
# nghị set riêng để phân tách rõ ràng phạm vi từng loại token).
TWO_FACTOR_TEMP_SECRET=""


