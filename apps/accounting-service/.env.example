# Kết nối tới PostgreSQL READ REPLICA (Mục 3.6.2 spec — KHÔNG bao giờ trỏ
# thẳng vào Primary cho query báo cáo nặng; ở local dev có thể tạm trỏ vào
# cùng DB với NestJS vì local không có replica riêng).
DATABASE_READ_URL="postgresql://postgres:postgres@localhost:5432/platform369"

# Kết nối RIÊNG chỉ có quyền INSERT/UPDATE trên 3-4 bảng report
# (accounting_reports, revenue_forecasts, tax_estimation_snapshots) — Mục 3.6.2 spec.
# Ở local dev dùng chung DATABASE_READ_URL cho đơn giản; production PHẢI tách
# user DB riêng với quyền hạn chế (GRANT INSERT, UPDATE ON accounting_reports...).
DATABASE_REPORT_WRITE_URL="postgresql://postgres:postgres@localhost:5432/platform369"

REDIS_URL="redis://localhost:6379"
INTERNAL_API_KEY="change-me-internal-api-key"
